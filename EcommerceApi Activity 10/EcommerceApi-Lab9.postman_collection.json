    {
      "name": "Products - Admin Only",
      "item": [
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Premium Headphones\",\n  \"description\": \"High-quality wireless headphones with noise cancellation\",\n  \"price\": 199.99,\n  \"category\": {\n    \"id\": 1\n  },\n  \"stockQuantity\": 25,\n  \"imageUrl\": \"https://via.placeholder.com/250x200?text=Headphones\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Create new product - requires ADMIN role and valid session"
          }
        },
        {
          "name": "Create Product - Validation Error (Negative Price)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product\",\n  \"description\": \"Test\",\n  \"price\": -50.00,\n  \"category\": {\n    \"id\": 1\n  },\n  \"stockQuantity\": 10,\n  \"imageUrl\": \"https://...\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Test validation - price must be greater than 0"
          }
        },
        {
          "name": "Create Product - 401 Not Authenticated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"description\": \"Test\",\n  \"price\": 99.99,\n  \"category\": { \"id\": 1 },\n  \"stockQuantity\": 10,\n  \"imageUrl\": \"https://...\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Try to create product without logging in - should return 401 Unauthorized"
          }
        },
        {
          "name": "Create Product - 403 Not Authorized (Regular User)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"description\": \"Test\",\n  \"price\": 99.99,\n  \"category\": { \"id\": 1 },\n  \"stockQuantity\": 10,\n  \"imageUrl\": \"https://...\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Try to create product as regular user - should return 403 Forbidden (requires ADMIN role)"
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product Name\",\n  \"description\": \"Updated description\",\n  \"price\": 149.99,\n  \"category\": {\n    \"id\": 1\n  },\n  \"stockQuantity\": 30,\n  \"imageUrl\": \"https://via.placeholder.com/250x200?text=Updated\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "1"]
            },
            "description": "Update existing product - requires ADMIN role"
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/products/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products", "1"]
            },
            "description": "Delete a product - requires ADMIN role and valid session"
          }
        }
      ]
    },
    {
      "name": "Testing Flow - Complete Scenario",
      "item": [
        {
          "name": "Step 1 - Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"SecurePass123\",\n  \"confirmPassword\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "First step: Register a new user"
          }
        },
        {
          "name": "Step 2 - Login with New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Second step: Login with the newly created user. Check for JSESSIONID cookie in response."
          }
        },
        {
          "name": "Step 3 - Get Products (with Session)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
