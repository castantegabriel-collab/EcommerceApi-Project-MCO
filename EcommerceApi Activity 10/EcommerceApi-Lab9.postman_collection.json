            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\",\n  \"description\": \"This should fail\",\n  \"price\": 99.99,\n  \"category\": { \"id\": 1 },\n  \"stockQuantity\": 10,\n  \"imageUrl\": \"https://...\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/products",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "products"]
            },
            "description": "Fifth step: Try to access protected endpoint after logout - should return 401 Unauthorized"
          }
        }
